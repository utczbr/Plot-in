{
  "profile_name": "default",
  "created_by": "installer",
  "install_scope": "local",
  "purpose": "user",
  "interface_mode": "gui",
  "runtime": {
    "models_dir": "/home/stuart/Documentos/OCR/LYAA-fine-tuning/src/models",
