    "ocr_settings": {
      "easyocr_gpu": true,
      "easyocr_download_enabled": false,
      "easyocr_contrast_ths": 0.0,
      "easyocr_adjust_contrast": 0.5,
      "easyocr_min_size": 10,
      "tesseract_psm": 6,
      "tesseract_oem": 3,
      "scale_factor": 3.0,
      "retry_on_suspicious": true,
      "aggressive_preprocessing": false,
      "languages": [
        "en",
        "pt"
      ],
      "easyocr_model_storage_dir": "/home/stuart/.EasyOCR"
    },
    "detection_thresholds": {
      "classification": 0.8,
      "bar_detection": 0.6,
      "box_detection": 0.6,
      "line_detection": 0.6,
